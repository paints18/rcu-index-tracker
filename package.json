{
  "name": "rcu-index-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Pet index progress tracker for Rebirth Champions Ultimate",
  "scripts": {
    "build": "tailwindcss -i styles/tailwind.css -o assets/styles.css --minify",
    "watch": "tailwindcss -i styles/tailwind.css -o assets/styles.css --watch",
    "serve": "python -m http.server 8765",
    "check": "python tools/validate.py"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
